from collections import defaultdict
# Global configuration constants
jug1, jug2, aim = 4, 3, 2 
# Initialize dictionary with default value as false
visited = defaultdict(lambda: False)
def waterJugSolver(amt1, amt2):
    # Goal condition: Either jug reaches the exact target amount
    if amt1 == aim or amt2 == aim:
        print(amt1, amt2)
        return True
    # State exploration if this configuration hasn't been evaluated
    if visited[(amt1, amt2)] == False:
        print(amt1, amt2)
        visited[(amt1, amt2)] = True 
        # Recursively evaluate all 6 possible production rules
        return (waterJugSolver(0, amt2) or
                waterJugSolver(amt1, 0) or
                waterJugSolver(jug1, amt2) or
                waterJugSolver(amt1, jug2) or
                waterJugSolver(amt1 + min(amt2, (jug1-amt1)), amt2 - min(amt2, (jug1-amt1))) or
                waterJugSolver(amt1 - min(amt1, (jug2-amt2)), amt2 + min(amt1, (jug2-amt2))))
    else:
        return False 
print("Steps: ") 
waterJugSolver(0, 0)
